---
import { z } from 'astro/zod';
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../../content/linked.json';

const links = z.array(z.object({
  name: z.string().trim().min(1),
  url: z.string().url().refine((url) => ['https:', 'http:'].includes(new URL(url).protocol), {
    message: 'Linked URLs must use https:// or http://',
  }),
}).strict()).parse(data);
---

<BaseLayout title="Linked" description="関連するリンクの一覧。">
  <section class="shell linked">
    <h1>Linked</h1>
    <p>関連するリンクをまとめています。</p>
    {links.length > 0 ? <ul>
      {links.map((link) => <li><a href={link.url}>{link.name}<span aria-hidden="true">↗</span></a></li>)}
    </ul> : <p>リンクはまだありません。</p>}
  </section>
</BaseLayout>

<style>
  .linked { max-width: 780px; padding-top: 64px; }
  h1 { margin: 0; font-size: clamp(2.3rem, 6vw, 4rem); letter-spacing: -0.045em; }
  p { color: var(--muted); }
  ul { margin-top: 40px; padding: 0; list-style: none; }
  li { border-bottom: 1px solid var(--line); }
  a { display: flex; justify-content: space-between; gap: 16px; padding: 22px 0; color: var(--accent); overflow-wrap: anywhere; }
</style>
