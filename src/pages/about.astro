---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('About requires content/pages/about/index.mdx');
const { Content } = await render(about);
---

<BaseLayout title={about.data.title} description={about.data.description}>
  <article class="shell about">
    <header>
      <h1>{about.data.title}</h1>
      <p>{about.data.description}</p>
    </header>
    <Prose><Content /></Prose>
  </article>
</BaseLayout>

<style>
  .about { max-width: 780px; padding-top: 64px; }
  header { margin-bottom: 48px; }
  h1 { margin: 0; font-size: clamp(2.3rem, 6vw, 4rem); letter-spacing: -0.045em; }
  header p { color: var(--muted); }
</style>
