---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteContent } from '../../lib/content';
const { articles, topics } = await getSiteContent();
const counts = new Map(topics.map((topic) => [topic.id, 0]));
for (const article of articles) {
  for (const topic of article.topics) counts.set(topic.id, (counts.get(topic.id) ?? 0) + 1);
}
---
<BaseLayout title="Topics" description="テーマから記事を探す">
  <section class="shell page">
    <header>
      <p class="eyebrow">Topics</p>
      <h1>テーマから探す</h1>
      <p>興味のある分野から、記事を読み進められます。</p>
    </header>
    <ul class="topic-list">
      {topics.map((topic) => (
        <li>
          <a href={`/topics/${topic.id}/`}>
            <h2>{topic.data.name}</h2>
            <p>{topic.data.description}</p>
            <span>{counts.get(topic.id)} 記事</span>
          </a>
        </li>
      ))}
    </ul>
    {topics.length === 0 && <p>Topicはまだありません。</p>}
  </section>
</BaseLayout>
<style>
  .page { max-width: 900px; padding-top: 72px; }
  header { margin-bottom: 50px; }
  .eyebrow { margin: 0 0 8px; color: var(--accent); font-weight: 650; }
  h1 { margin: 0; font-size: clamp(2.3rem, 6vw, 4rem); letter-spacing: -0.045em; }
  header > p:last-child, li p, li span { color: var(--muted); }
  .topic-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 20px; list-style: none; padding: 0; }
  li a { display: block; height: 100%; padding: 24px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); text-decoration: none; }
  li a:hover, li a:focus-visible { border-color: var(--accent); }
  h2 { margin: 0; font-size: 1.35rem; }
  li p { margin: 12px 0; }
  li span { font-size: 0.85rem; }
</style>
