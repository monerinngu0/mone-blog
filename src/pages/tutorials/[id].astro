---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prerequisites from '../../components/Prerequisites.astro';
import { getSiteContent } from '../../lib/content';
export async function getStaticPaths() {
  const { tutorials } = await getSiteContent();
  return tutorials.map((tutorial) => ({ params: { id: tutorial.id }, props: { tutorial } }));
}
const { tutorial } = Astro.props;
---
<BaseLayout title={tutorial.data.title} description={tutorial.data.description}>
  <section class="shell page">
    <a href="/tutorials/">すべてのTutorials</a>
    <h1>{tutorial.data.title}</h1>
    <p>{tutorial.data.description}</p>
    <Prerequisites items={tutorial.prerequisites} />
    <p>{tutorial.chapters.length} 章</p>
    <a class="start" href={`/articles/${tutorial.chapters[0].id}/`}>第1章から読む →</a>
    <ol>
      {tutorial.chapters.map((chapter) => <li>
        <h2><a href={`/articles/${chapter.id}/`}>{chapter.data.title}</a></h2>
        <p>{chapter.data.description}</p>
      </li>)}
    </ol>
  </section>
</BaseLayout>
<style>
  .page { max-width: 900px; padding-top: 64px; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.3; }
  p { color: var(--muted); }
  .start { display: inline-block; padding: 12px 18px; border: 1px solid var(--line); border-radius: 8px; }
  ol { padding-left: 1.8rem; margin-top: 36px; }
  li { padding: 18px 0; border-top: 1px solid var(--line); }
  h2 { margin: 0; font-size: 1.3rem; }
</style>
