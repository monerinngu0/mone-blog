---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteContent } from '../../lib/content';
const { tutorials } = await getSiteContent();
---

<BaseLayout title="Tutorials" description="記事を順番に読み進めて学ぶシリーズ">
    <section class="shell page">
        <h1>チュートリアルくん</h1>
        <p>ちゅーとりあるです</p>
        <ul>
            {tutorials.map((tutorial) => (
                <li>
                    <h2>
                        <a href={`/tutorials/${tutorial.id}/`}>{tutorial.data.title}</a>
                    </h2>
                    <p>{tutorial.data.description}</p>
                    <span>{tutorial.chapters.length} 章</span>
                </li>
            ))}
        </ul>
        {tutorials.length === 0 && <p>公開中のTutorialはまだありません。</p>}
    </section>
</BaseLayout>
<style>
    .page {
        max-width: 900px;
        padding-top: var(--page-top);
    }
    h1 {
        font-size: var(--page-title-size);
        line-height: 1.3;
        margin: 0;
    }
    ul {
        list-style: none;
        padding: 0;
        margin-top: 28px;
    }
    li {
        padding: 20px 0;
        border-top: 1px solid var(--line);
    }
    h2 {
        margin: 0;
        font-size: 1.125rem;
    }
    p,
    span {
        color: var(--muted);
    }
</style>
