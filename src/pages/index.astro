---
import { getSiteContent } from '../lib/content';
import TopicLinks from '../components/TopicLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const { articles: allArticles, featuredTutorial, topics } = await getSiteContent();
const articles = allArticles.slice(0, 5);
const topicCounts = new Map(topics.map((topic) => [topic.id, 0]));
for (const article of allArticles) {
  for (const topic of article.topics) {
    topicCounts.set(topic.id, (topicCounts.get(topic.id) ?? 0) + 1);
  }
}
---

<BaseLayout>
  <section class="hero shell">
    <h1>モネのブログ</h1>
    <p class="intro">
      興味深い話をいっぱいしたいです。
    </p>
  </section>

  <section class="latest shell">
    <div class="section-heading">
      <h2>最新の記事</h2>
      <a href="/articles/">すべて見る →</a>
    </div>

    <div class="article-list">
      {articles.length === 0 && <p>記事はまだありません。</p>}
      {articles.map((article) => (
        <article class="article-card">
          <div>
            <TopicLinks topics={article.topics} />
            <h3><a href={`/articles/${article.id}/`}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
          </div>
          <time datetime={article.data.publishedAt.toISOString()}>
            {article.data.publishedAt.toLocaleDateString('ja-JP')}
          </time>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section shell">
    <div class="section-heading">
      <h2>おすすめのチュートリアル</h2>
      <a href="/tutorials/">すべて見る →</a>
    </div>

    {featuredTutorial ? (
      <a class="tutorial-row" href={`/tutorials/${featuredTutorial.id}/`}>
        <div>
          <h3>{featuredTutorial.data.title}</h3>
          <p>{featuredTutorial.data.description}</p>
        </div>
        <span>{featuredTutorial.chapters.length} 章</span>
      </a>
    ) : <p class="empty">おすすめのチュートリアルはまだありません。</p>}
  </section>

  <section class="home-section shell">
    <div class="section-heading">
      <h2>トピック</h2>
      <a href="/topics/">すべて見る →</a>
    </div>

    <ul class="topic-grid">
      {topics.map((topic) => (
        <li>
          <a href={`/topics/${topic.id}/`}>
            <strong>{topic.data.name}</strong>
            <span>{topicCounts.get(topic.id)} 記事</span>
          </a>
        </li>
      ))}
    </ul>
    {topics.length === 0 && <p class="empty">トピックはまだありません。</p>}
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--page-top);
    padding-bottom: 32px;
  }

  h1 {
    max-width: 800px;
    margin: 0 0 12px;
    padding-left: 14px;
    border-left: 5px solid var(--accent);
    font-size: var(--page-title-size);
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .intro {
    max-width: 660px;
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
  }

  .latest {
    padding-top: 0;
  }

  .home-section {
    margin-top: 48px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .section-heading h2 {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    font-size: 1.125rem;
  }

  .section-heading h2::before {
    content: '';
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--highlight);
  }

  .section-heading a {
    color: var(--accent);
    font-size: 0.9rem;
  }

  .article-card {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .article-card h3 {
    margin: 5px 0 7px;
    font-size: 1.125rem;
  }

  .article-card h3 a:hover {
    color: var(--accent-strong);
  }

  .article-card p,
  .article-card time,
  .topics {
    color: var(--muted);
  }

  .article-card p {
    margin: 0;
  }

  .topics {
    font-size: 0.8rem;
  }

  .article-card time {
    flex: none;
    font-size: 0.85rem;
  }

  .tutorial-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0 20px 16px;
    border-bottom: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    text-decoration: none;
  }

  .tutorial-row h3 {
    margin: 0 0 6px;
    font-size: 1.125rem;
  }

  .tutorial-row p {
    margin: 0;
    color: var(--muted);
  }

  .tutorial-row > span {
    flex: none;
    color: var(--accent-strong);
    font-size: 0.85rem;
    font-weight: 650;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 12px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .topic-grid a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    text-decoration: none;
  }

  .topic-grid a:hover,
  .topic-grid a:focus-visible {
    border-color: var(--highlight);
    background: var(--highlight-soft);
    color: var(--text);
  }

  .topic-grid span,
  .empty {
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .article-card {
      flex-direction: column;
      gap: 8px;
    }

    .tutorial-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
