---
import { getSiteContent } from '../lib/content';
import TopicLinks from '../components/TopicLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const { articles: allArticles } = await getSiteContent();
const articles = allArticles.slice(0, 5);
---

<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">Mone dayo</p>
    <h1>モネのブログ</h1>
    <p class="intro">
      興味深い話をいっぱいしたいです。
    </p>
  </section>

  <section class="latest shell">
    <div class="section-heading">
      <h2>最新の記事</h2>
      <a href="/articles/">すべて見る →</a>
    </div>

    <div class="article-list">
      {articles.length === 0 && <p>記事はまだありません。</p>}
      {articles.map((article) => (
        <article class="article-card">
          <div>
            <TopicLinks topics={article.topics} />
            <h3><a href={`/articles/${article.id}/`}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
          </div>
          <time datetime={article.data.publishedAt.toISOString()}>
            {article.data.publishedAt.toLocaleDateString('ja-JP')}
          </time>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--page-top);
    padding-bottom: 32px;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 650;
  }

  h1 {
    max-width: 800px;
    margin: 8px 0 12px;
    font-size: var(--page-title-size);
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .intro {
    max-width: 660px;
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
  }

  .latest {
    padding-top: 0;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.125rem;
  }

  .section-heading a {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .article-card {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .article-card h3 {
    margin: 5px 0 7px;
    font-size: 1.125rem;
  }

  .article-card p,
  .article-card time,
  .topics {
    color: var(--muted);
  }

  .article-card p {
    margin: 0;
  }

  .topics {
    font-size: 0.8rem;
  }

  .article-card time {
    flex: none;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .article-card {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
