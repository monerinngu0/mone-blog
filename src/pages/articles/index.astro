---
import { getSiteContent } from '../../lib/content';
import TopicLinks from '../../components/TopicLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { articles } = await getSiteContent();
---

<BaseLayout title="Articles" description="すべての記事">
    <section class="shell page">
        <header>
            <h1>記事さん</h1>
            <p>キジ(鳥)です</p>
        </header>

        <div class="article-list">
            {articles.map((article) => (
                <article class="article-card">
                    <TopicLinks topics={article.topics} />
                    <h2>
                        <a href={`/articles/${article.id}/`}>{article.data.title}</a>
                    </h2>
                    <p>{article.data.description}</p>
                    <time datetime={article.data.publishedAt.toISOString()}>
                        {article.data.publishedAt.toLocaleDateString('ja-JP')}
                    </time>
                </article>
            ))}
        </div>
    </section>
</BaseLayout>

<style>
    .page {
        max-width: 900px;
        padding-top: var(--page-top);
    }

    header {
        margin-bottom: 28px;
    }

    h1 {
        margin: 0;
        font-size: var(--page-title-size);
        line-height: 1.3;
        letter-spacing: -0.025em;
    }

    header > p:last-child {
        color: var(--muted);
    }

    .article-card {
        display: block;
        padding: 20px 0;
        border-top: 1px solid var(--line);
        text-decoration: none;
    }

    .article-card h2 {
        margin: 5px 0 7px;
        font-size: 1.125rem;
    }

    .article-card p {
        margin: 0 0 8px;
        color: var(--muted);
    }

    .meta,
    time {
        color: var(--muted);
        font-size: 0.82rem;
    }
</style>
