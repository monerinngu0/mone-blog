---
import { getSiteContent } from '../../lib/content';
import TopicLinks from '../../components/TopicLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { articles, tutorials } = await getSiteContent();
const isDev = import.meta.env.DEV;
const tutorialArticleIds = new Set(
    tutorials.flatMap((tutorial) => tutorial.chapters.map((article) => article.id)),
);
const standaloneArticleCount = articles.filter(
    (article) => !tutorialArticleIds.has(article.id),
).length;
---

<BaseLayout title="Articles" description="すべての記事">
    <section class="shell page">
        <header>
            <h1>記事さん</h1>
            <p>キジ(鳥)です</p>
        </header>

        <div class="article-filter">
            <input id="standalone-only" type="checkbox" />
            <label for="standalone-only">Tutorialに含まれない記事のみ</label>
        </div>

        {isDev && (
            <div class="article-filter">
                <input id="published-only" type="checkbox" />
                <label for="published-only">draftがfalseの記事のみ</label>
            </div>
        )}

        <div class="article-list">
            {articles.map((article) => (
                <article
                    class="article-card content-row"
                    data-in-tutorial={tutorialArticleIds.has(article.id) ? 'true' : undefined}
                    data-draft={article.data.draft ? 'true' : undefined}
                >
                    <TopicLinks topics={article.topics} />
                    <h2>
                        <a class="content-row-link" href={`/articles/${article.id}/`}>
                            {article.data.title}
                        </a>
                    </h2>
                    <p>{article.data.description}</p>
                    <time datetime={article.data.publishedAt.toISOString()}>
                        {article.data.publishedAt.toLocaleDateString('ja-JP')}
                    </time>
                </article>
            ))}
        </div>
        {standaloneArticleCount === 0 && (
            <p class="standalone-empty">Tutorialに含まれない記事はありません。</p>
        )}
    </section>
</BaseLayout>

<style>
    .page {
        max-width: 900px;
        padding-top: var(--page-top);
    }

    header {
        margin-bottom: 28px;
    }

    .article-filter {
        display: flex;
        align-items: center;
        gap: 9px;
        width: fit-content;
        margin-bottom: 12px;
        color: var(--muted);
        font-size: 0.9rem;
    }

    .article-filter input {
        width: 1rem;
        height: 1rem;
        margin: 0;
        accent-color: var(--accent);
        cursor: pointer;
    }

    .article-filter label {
        cursor: pointer;
        user-select: none;
    }

    .page:has(#standalone-only:checked) .article-card[data-in-tutorial='true'] {
        display: none;
    }

    .page:has(#published-only:checked) .article-card[data-draft='true'] {
        display: none;
    }

    .standalone-empty {
        display: none;
        color: var(--muted);
    }

    .page:has(#standalone-only:checked) .standalone-empty {
        display: block;
    }

    h1 {
        margin: 0;
        font-size: var(--page-title-size);
        line-height: 1.3;
        letter-spacing: -0.025em;
    }

    header > p:last-child {
        color: var(--muted);
    }

    .article-card {
        display: block;
        padding-block: 20px;
        border-top: 1px solid var(--line);
        text-decoration: none;
    }

    .article-card h2 {
        margin: 5px 0 7px;
        font-size: 1.125rem;
    }

    .article-card p {
        margin: 0 0 8px;
        color: var(--muted);
    }

    .meta,
    time {
        color: var(--muted);
        font-size: 0.82rem;
    }
</style>
