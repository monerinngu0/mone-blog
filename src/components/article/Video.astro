---
interface Props {
  src: string;
  title: string;
  type?: string;
  poster?: string;
  captions?: string;
  caption?: string;
  autoplay?: boolean;
  loop?: boolean;
}

const {
  src,
  title,
  type,
  poster,
  captions,
  caption,
  autoplay = false,
  loop = false,
} = Astro.props;
---

<figure class="video-figure">
  <video
    controls
    playsinline
    preload="metadata"
    poster={poster}
    autoplay={autoplay}
    muted={autoplay}
    loop={loop}
    aria-label={title}
  >
    <source src={src} type={type} />
    {captions && <track kind="captions" src={captions} srclang="ja" label="日本語" default />}
    動画を再生できないブラウザです。
  </video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video-figure {
    margin: 2rem 0;
  }

  video {
    display: block;
    width: 100%;
    max-height: min(72vh, 44rem);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #000;
  }

  figcaption {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
    text-align: center;
  }
</style>
