---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  eager?: boolean;
}

const { src, alt, caption, eager = false } = Astro.props;
const isLocalImage = typeof src !== 'string';
---

<figure class="article-media">
  {isLocalImage ? (
    <Image
      src={src}
      data-zoom-src={typeof src === 'string' ? src : src.src}
      alt={alt}
      widths={[480, 768, 1100]}
      sizes="(max-width: 820px) calc(100vw - 40px), 780px"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .article-media {
    margin: 2rem 0;
  }

  .article-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  figcaption {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
    text-align: center;
  }
</style>
