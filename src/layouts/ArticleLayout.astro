---
import 'katex/dist/katex.min.css';
import type { CollectionEntry } from 'astro:content';
import TopicLinks from '../components/TopicLinks.astro';
import BaseLayout from './BaseLayout.astro';
import TutorialNav from '../components/TutorialNav.astro';
import type { Tutorial, Prerequisite } from '../lib/content';
import Prerequisites from '../components/Prerequisites.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  topics: CollectionEntry<'topics'>[];
  prerequisites: Prerequisite[];
  articleId: string;
  tutorial?: Tutorial;
}

const { title, description, publishedAt, updatedAt, topics, prerequisites, articleId, tutorial } = Astro.props;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long' }).format(date);
---

<BaseLayout title={title} description={description}>
  <div class:list={['reading shell', { 'with-tutorial': !!tutorial }]}>
    {tutorial && <aside class="chapter-sidebar">
      <TutorialNav tutorial={tutorial} articleId={articleId} />
    </aside>}
  <article class="article">
    <header class="article-header">
      <TopicLinks topics={topics} />
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="dates">
        <span>公開: {formatDate(publishedAt)}</span>
        {updatedAt && <span>更新: {formatDate(updatedAt)}</span>}
      </div>

      <Prerequisites items={prerequisites} />
    </header>

    <div class="prose">
      <slot />
    </div>
    {tutorial && <TutorialNav tutorial={tutorial} articleId={articleId} compact />}
  </article>
  </div>
</BaseLayout>

<style>
  .reading {
    max-width: 780px;
    padding-top: 64px;
  }
  .article { min-width: 0; }
  .chapter-sidebar { min-width: 0; }
  @media (min-width: 1000px) {
    .reading.with-tutorial { max-width: 1100px; display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 48px; }
    .chapter-sidebar { position: sticky; top: 24px; align-self: start; max-height: calc(100vh - 48px); overflow-y: auto; }
  }

  .article-header {
    margin-bottom: 52px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.18;
    letter-spacing: -0.035em;
  }

  .lead {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .prose :global(h2) {
    margin-top: 2.6em;
    font-size: 1.65rem;
    line-height: 1.35;
  }

  .prose :global(h3) {
    margin-top: 2em;
    font-size: 1.25rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 1.2em;
  }

  .prose :global(a) {
    color: var(--accent);
  }
</style>
