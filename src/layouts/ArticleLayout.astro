---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  topics: string[];
  prerequisites: string[];
}

const { title, description, publishedAt, updatedAt, topics, prerequisites } = Astro.props;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long' }).format(date);
---

<BaseLayout title={title} description={description}>
  <article class="article shell">
    <header class="article-header">
      <div class="topics">
        {topics.map((topic) => <span>{topic}</span>)}
      </div>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="dates">
        <span>公開: {formatDate(publishedAt)}</span>
        {updatedAt && <span>更新: {formatDate(updatedAt)}</span>}
      </div>

      {prerequisites.length > 0 && (
        <aside class="prerequisites">
          <strong>Prerequisites</strong>
          <ul>
            {prerequisites.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 780px;
    padding-top: 64px;
  }

  .article-header {
    margin-bottom: 52px;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .topics span {
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.18;
    letter-spacing: -0.035em;
  }

  .lead {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .prerequisites {
    margin-top: 28px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .prerequisites ul {
    margin: 8px 0 0;
    padding-left: 1.3rem;
  }

  .prose :global(h2) {
    margin-top: 2.6em;
    font-size: 1.65rem;
    line-height: 1.35;
  }

  .prose :global(h3) {
    margin-top: 2em;
    font-size: 1.25rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 1.2em;
  }

  .prose :global(a) {
    color: var(--accent);
  }
</style>
