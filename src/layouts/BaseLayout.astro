---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'mone',
  description = 'C++やコンピュータ科学を、仕組みから深く理解するための技術サイト。',
} = Astro.props;

const pageTitle = title === 'mone' ? title : `${title} | mone`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">mone</a>
        <nav aria-label="メインナビゲーション">
          <a href="/articles/">Articles</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="shell">© {new Date().getFullYear()} mone</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family:
      Inter, "Noto Sans JP", system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    --bg: #fafafa;
    --surface: #ffffff;
    --text: #1d2433;
    --muted: #667085;
    --line: #e4e7ec;
    --accent: #39456f;
    --code-bg: #151821;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111318;
      --surface: #181b22;
      --text: #eaecf0;
      --muted: #98a2b3;
      --line: #2b303b;
      --accent: #aab4df;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--text);
  }

  body {
    margin: 0;
    min-height: 100vh;
    line-height: 1.75;
  }

  a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-underline-offset: 0.2em;
  }

  .shell {
    width: min(1100px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    width: min(1100px, calc(100% - 40px));
    min-height: 64px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    font-weight: 750;
    font-size: 1.1rem;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    gap: 20px;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: var(--text);
  }

  footer {
    margin-top: 80px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }

  code {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  :not(pre) > code {
    padding: 0.12em 0.38em;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--surface);
    font-size: 0.9em;
  }

  pre {
    overflow-x: auto;
    padding: 18px 20px;
    border-radius: 10px;
    background: var(--code-bg) !important;
    line-height: 1.6;
  }
</style>
