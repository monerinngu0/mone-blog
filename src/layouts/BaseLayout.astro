---
import LinkedMenu from '../components/LinkedMenu.astro';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'mone',
    description = 'C++やコンピュータ科学を、仕組みから深く理解するための技術サイト。',
} = Astro.props;

const pageTitle = title === 'mone' ? title : `${title} | mone`;
const navigation = [
    { href: '/', label: 'Home' },
    { href: '/articles/', label: 'Articles' },
    { href: '/tutorials/', label: 'Tutorials' },
    { href: '/topics/', label: 'Topics' },
    { href: '/about/', label: 'About' },
];
const path = `${Astro.url.pathname.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body>
        <header class="site-header">
            <div class="header-inner">
                <a class="brand" href="/">
                    mone
                </a>
                <nav aria-label="メインナビゲーション">
                    {navigation.map(({ href, label }) => (
                        <a href={href} aria-current={path === href ? 'page' : undefined}>
                            {label}
                        </a>
                    ))}
                    <LinkedMenu />
                </nav>
            </div>
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <div class="shell">© {new Date().getFullYear()} mone</div>
        </footer>
    </body>
</html>

<style is:global>
    :root {
        color-scheme: light dark;
        font-family:
            Inter,
            'Noto Sans JP',
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            'Segoe UI',
            sans-serif;
        --bg: #fafafa;
        --surface: #ffffff;
        --text: #1d2433;
        --muted: #667085;
        --line: #e4e7ec;
        --accent: #6550a4;
        --accent-strong: #4f378b;
        --accent-soft: #eee8ff;
        --highlight: #e5b700;
        --highlight-soft: #fff1a8;
        --code-bg: #151821;
        --site-header-height: 64px;
        --page-top: clamp(32px, 5vw, 40px);
        --page-title-size: clamp(2rem, 4vw, 2.5rem);
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --bg: #111318;
            --surface: #181b22;
            --text: #eaecf0;
            --muted: #98a2b3;
            --line: #2b303b;
            --accent: #c9bfff;
            --accent-strong: #ded8ff;
            --accent-soft: #302a49;
            --highlight: #f1cb4b;
            --highlight-soft: #493f1f;
        }
    }

    * {
        box-sizing: border-box;
    }

    html {
        background: var(--bg);
        color: var(--text);
        scroll-padding-top: calc(var(--site-header-height) + 16px);
    }

    body {
        margin: 0;
        min-height: 100vh;
        line-height: 1.75;
    }

    a {
        color: inherit;
        text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
        text-underline-offset: 0.2em;
    }

    a:hover {
        color: var(--accent-strong);
    }

    ::selection {
        background: var(--highlight-soft);
    }

    .shell {
        width: min(1100px, calc(100% - 40px));
        margin-inline: auto;
    }

    .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid var(--line);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
    }

    .header-inner {
        width: min(1100px, calc(100% - 40px));
        min-height: var(--site-header-height);
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px 28px;
        flex-wrap: wrap;
        padding-block: 14px;
    }

    .brand {
        color: var(--accent);
        font-weight: 750;
        font-size: 1.1rem;
        text-decoration: none;
        letter-spacing: -0.02em;
    }

    .brand::after {
        content: '';
        display: inline-block;
        width: 0.42em;
        height: 0.42em;
        margin-left: 0.28em;
        border-radius: 50%;
        background: var(--highlight);
        vertical-align: 0.12em;
    }

    nav {
        display: flex;
        gap: 10px 20px;
        flex-wrap: wrap;
    }

    nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
    }

    nav a:hover,
    nav a[aria-current='page'] {
        color: var(--accent);
    }

    nav a[aria-current='page'] {
        text-decoration: underline;
        text-decoration-color: var(--highlight);
        text-decoration-thickness: 2px;
    }

    footer {
        margin-top: 48px;
        padding: 20px 0;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.9rem;
    }

    code {
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
    }

    :not(pre) > code {
        padding: 0.12em 0.38em;
        border: 1px solid var(--line);
        border-radius: 5px;
        background: var(--surface);
        font-size: 0.9em;
    }

    pre {
        overflow-x: auto;
        padding: 18px 20px;
        border-radius: 10px;
        background: var(--code-bg) !important;
        line-height: 1.6;
    }

    .katex-display {
        overflow-x: auto;
        overflow-y: hidden;
        padding-block: 0.35rem;
    }
</style>
